# --- Hensu Project Gitignore ---

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Kotlin
*.kotlin_module
.kotlin/
# Kotlin Scripting / DSL artifacts
*.kts.jar
*.kts.bin

# Quarkus
.quarkus/
bin/
# Quarkus dev mode and testing artifacts
target/
quarkus-app/
*.log
*.trace

# Java / JVM
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Python (fixture MCP servers under working-dir/)
__pycache__/

# TLA+ / TLC run artifacts (specs and configurations are committed, run output is not)
docs/tla/output/
docs/tla/states/
docs/tla/*_TTrace_*

# Local ticket backlog (kept per developer, not committed)
docs/tickets/

# IDEs (IntelliJ IDEA)
.idea/
*.iml
*.iws
out/
# !.idea/runConfigurations/

# IDEs (VS Code)
.vscode/
*.code-workspace

# OS specific
.DS_Store
Thumbs.db

# Environment & Secrets
.env
.env.local
*.properties
!gradle.properties
local.properties

# Developer JWT keys (personal per-developer, never committed)
dev/keys/
**/key/publicKey.pem
**/key/privateKey.pem
dev/keys/privateKey.pem
dev/keys/publicKey.pem
publicKey.pem

# GraalVM / Native Image
*.exe
*.so
*.dylib
*.dll
*-native-image-libs/

# AI, Semantic Search & Agents (Pommel, Claude Code, etc.)
.pommel/
.claudecode/
**/embeddings/
**/chunks/
.anthropic/
.mem/
/.claude/projects/
/.claude/tmp/
/.claude/plans/

# Local MCP overrides
.mcp.local.json
